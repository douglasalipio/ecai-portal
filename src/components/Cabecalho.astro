---
/**
 * Barra fixa do topo: brasao, navegacao de desktop e botao do menu.
 *
 * No site antigo eram 14 atributos style= inline neste trecho, repetidos em
 * cada uma das 9 paginas. Aqui e um componente com estilo escopado.
 */
import { conteudo } from '../dados/conteudo';
import { menu, type Tela } from '../dados/navegacao';

interface Props {
  tela: Tela;
  /** Botao da lista de interesse; so nas paginas da loja. */
  mostrarLista?: boolean;
}

const { tela, mostrarLista = false } = Astro.props;
const { site } = conteudo;
---

<div class="cabecalho sec">
  <a href="index.html" class="marca">
    <img src="logo-ife.jpg" alt={site.nomeCompleto} width="38" height="38" />
    <div class="marca-texto">
      <span class="marca-nome">{site.nome}</span>
      <span class="marca-linha">Escola de Capoeira Angola</span>
    </div>
  </a>

  <nav class="nav-desk">
    {menu.map((i) => (
      <a href={i.url} aria-current={i.tela === tela ? 'page' : undefined}>{i.rotulo}</a>
    ))}
  </nav>

  <div class="acoes">
    {mostrarLista && (
      <button class="lista-btn hv1" data-lista-abrir aria-label="Ver minha lista">
        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
          <path d="M3 6h18"></path>
          <path d="M16 10a4 4 0 0 1-8 0"></path>
        </svg>
        <span class="conta" data-lista-conta hidden>0</span>
      </button>
    )}

    <button class="menu-btn hv1" onclick="alternarMenu(event)" aria-label="Menu" aria-controls="menu" aria-expanded="false">
      <span></span>
      <span class="verde"></span>
      <span></span>
    </button>
  </div>
</div>

<style>
  .cabecalho {
    position: sticky;
    top: 0;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    height: 62px;
    padding: 0 16px;
    background: var(--cor-tinta);
    color: var(--cor-papel);
    border-bottom: 1px solid rgba(255, 255, 255, .14);
  }

  .marca {
    display: flex;
    align-items: center;
    gap: 9px;
    text-decoration: none;
    color: inherit;
    cursor: pointer;
  }
  .marca img {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    object-fit: cover;
    background: var(--cor-papel);
  }
  .marca-texto { display: flex; flex-direction: column; line-height: 1; }
  .marca-nome {
    font-family: var(--fonte-titulo);
    font-size: 15px;
    letter-spacing: .01em;
  }
  .marca-linha {
    font-size: 8.5px;
    letter-spacing: .18em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, .5);
    margin-top: 3px;
  }

  .acoes { display: flex; align-items: center; gap: 8px; }

  .lista-btn {
    position: relative;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, .28);
    background: transparent;
    color: var(--cor-papel);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }
  .conta {
    position: absolute;
    top: -3px;
    right: -3px;
    min-width: 18px;
    height: 18px;
    padding: 0 4px;
    border-radius: var(--raio-pilula);
    background: var(--cor-verde);
    color: var(--cor-tinta);
    font-size: 11px;
    font-weight: 700;
    line-height: 18px;
    text-align: center;
  }
  .conta[hidden] { display: none; }

  .menu-btn {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, .28);
    background: transparent;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4px;
    cursor: pointer;
  }
  .menu-btn span {
    width: 16px;
    height: 2px;
    background: var(--cor-papel);
  }
  .menu-btn .verde { background: var(--cor-verde); }
</style>
