---
/**
 * Aulas e horarios — capa escura listrada, cartoes de turma, chamada para a
 * aula experimental e o FAQ.
 */
import Base from '../layouts/Base.astro';
import Faq from '../components/Faq.astro';
import { conteudo } from '../dados/conteudo';

const { site, turmas } = conteudo;

/** Destino do botao: WhatsApp se houver, senao Instagram. */
const contato = site.contatoAula || site.whatsapp || site.instagram;
---

<Base titulo="Aulas e horários" tela="aulas" arquivo="aulas.html">
  <div>
    <div class="capa sec">
      <div class="listras zebra-campo zebra-branca-07"></div>
      <span class="sobretitulo">Turmas</span>
      <h1>Venha jogar com a gente</h1>
      <p>Sem experiência, sem uniforme, sem idade certa. A primeira aula é gratuita e você só precisa de roupa leve.</p>
      <a class="botao hv2" href="#experimental">Agendar aula experimental</a>
    </div>

    <div class="turmas sec">
      <div class="pilha">
        {turmas.map((t) => (
          <div class="turma">
            <div class="turma-topo">
              <div class="turma-nome">{t.nome}</div>
              <div class="turma-idade">{t.idade}</div>
            </div>
            <div class="turma-texto">{t.texto}</div>
            <div class="dias">
              {t.dias.map((d) => <span class="dia">{d}</span>)}
            </div>
          </div>
        ))}
      </div>
    </div>

    <div class="zebra zebra-preta divisa sec bleed"></div>

    <div class="experimental sec">
      <h2>Aula experimental</h2>
      <p>Chame a gente e te esperamos na próxima aula do núcleo mais perto de você.</p>
      <div class="pilha">
        <a class="quero hv3" href={contato} target="_blank" rel="noopener">Quero experimentar</a>
      </div>
    </div>

    <div class="perguntas sec">
      <h2>Perguntas frequentes</h2>
      <Faq />
    </div>
  </div>
</Base>

<style>
  .capa {
    padding: 30px 20px 26px;
    background: var(--cor-tinta);
    color: var(--cor-papel);
    position: relative;
    overflow: hidden;
  }
  .listras { position: absolute; inset: 0; pointer-events: none; }
  .capa > :not(.listras) { position: relative; }

  .sobretitulo {
    font-size: 10px;
    letter-spacing: .2em;
    text-transform: uppercase;
    color: var(--cor-verde);
  }
  .capa h1 {
    font-family: var(--fonte-titulo);
    font-size: 42px;
    line-height: .94;
    letter-spacing: -.025em;
    text-transform: uppercase;
    margin: 10px 0 12px;
  }
  .capa p {
    margin: 0 0 20px;
    font-size: 14.5px;
    line-height: 1.6;
    color: var(--cor-papel-82);
  }
  .botao {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    min-height: 50px;
    padding: 0 22px;
    border: 0;
    border-radius: var(--raio-pilula);
    background: var(--cor-verde);
    color: var(--cor-tinta);
    font-family: var(--fonte-titulo);
    font-size: 14.5px;
    text-decoration: none;
    cursor: pointer;
  }

  .turmas { padding: 30px 20px 32px; background: var(--cor-papel); }
  .pilha { display: flex; flex-direction: column; gap: 14px; }

  .turma { padding: 20px; border-radius: 24px; border: 1px solid rgba(11, 11, 11, .12); }
  .turma-topo {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 10px;
    margin-bottom: 10px;
  }
  .turma-nome {
    font-family: var(--fonte-titulo);
    font-size: 24px;
    text-transform: uppercase;
    letter-spacing: -.02em;
    line-height: 1;
  }
  .turma-idade {
    font-size: 11px;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: rgba(11, 11, 11, .5);
  }
  .turma-texto {
    font-size: 13.5px;
    line-height: 1.55;
    color: rgba(11, 11, 11, .68);
    margin-bottom: 14px;
  }
  .dias { display: flex; flex-wrap: wrap; gap: 7px; }
  .dia {
    font-size: 12px;
    font-weight: 600;
    padding: 7px 12px;
    border-radius: var(--raio-pilula);
    background: var(--cor-superficie);
  }

  .divisa { height: 26px; background-color: var(--cor-papel); }

  .experimental { padding: 32px 20px 36px; background: var(--cor-superficie); }
  .perguntas { padding: 32px 20px 36px; background: var(--cor-papel); }

  h2 {
    font-family: var(--fonte-titulo);
    font-size: 28px;
    line-height: 1;
    letter-spacing: -.02em;
    text-transform: uppercase;
    margin: 0 0 6px;
  }
  .perguntas h2 { margin: 0 0 18px; }

  .experimental p {
    margin: 0 0 18px;
    font-size: 14px;
    line-height: 1.55;
    color: rgba(11, 11, 11, .66);
  }
  .experimental .pilha { gap: 10px; }

  .quero {
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    box-sizing: border-box;
    min-height: 52px;
    border: 0;
    border-radius: var(--raio-pilula);
    background: var(--cor-tinta);
    color: var(--cor-papel);
    font-family: var(--fonte-titulo);
    font-size: 15px;
    text-decoration: none;
    cursor: pointer;
    margin-top: 4px;
  }
</style>
