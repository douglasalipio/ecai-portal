---
/** Galeria — a lista `galeria` do conteudo, na ordem em que estiver la. */
import Base from '../layouts/Base.astro';
import CabecaPagina from '../components/CabecaPagina.astro';
import GradeGaleria from '../components/GradeGaleria.astro';
---

<Base titulo="Galeria" tela="galeria" arquivo="galeria.html">
  <div>
    <CabecaPagina
      sobretitulo="Acervo"
      titulo="Galeria"
      texto="Fotos das rodas, das aulas e dos nossos encontros."
      recuoTexto="18px"
    />

    <div class="corpo sec">
      <GradeGaleria primeiraAnsiosa />
    </div>
  </div>
</Base>

<style>
  .corpo { padding: 8px 20px 34px; background: var(--cor-papel); }
</style>
