---
/**
 * Pagina de um produto. Uma rota gera todas, como nucleo-[slug].
 *
 * O botao adiciona a lista de interesse; nao compra. Produto com variacao
 * exige escolher antes, senao P e G virariam a mesma linha na lista.
 */
import Base from '../layouts/Base.astro';
import { produtos, loja, emReais, type Produto } from '../dados/produtos';

export function getStaticPaths() {
  return produtos.map((p) => ({ params: { slug: p.slug }, props: { produto: p } }));
}

interface Props { produto: Produto }
const { produto } = Astro.props;
const variacao = produto.variacoes[0];
---

<Base titulo={produto.nome} tela="loja" arquivo={`produto-${produto.slug}.html`}>
  <div>
    <div class="capa sec bleed">
      <img src={produto.fotos[0]} alt={produto.nome} decoding="async" />
      <a class="voltar hv2" href="loja.html">← Loja</a>
    </div>

    <div class="corpo sec">
      <h1>{produto.nome}</h1>
      <div class="preco">{emReais(produto.preco)}</div>
      <p class="descricao">{produto.descricao}</p>

      {variacao && (
        <label class="escolha">
          <span>{variacao.nome}</span>
          <select data-variacao={produto.slug}>
            {variacao.opcoes.map((o) => <option value={o}>{o}</option>)}
          </select>
        </label>
      )}

      <button class="adicionar hv2" data-adicionar={produto.slug}>Pôr na minha lista</button>
      <p class="frete">{loja.avisoFrete}</p>

      {produto.fotos.length > 1 && (
        <div class="mais-fotos">
          {produto.fotos.slice(1).map((f) => (
            <img src={f} alt={produto.nome} loading="lazy" decoding="async" />
          ))}
        </div>
      )}
    </div>
  </div>
</Base>

<style>
  .capa { position: relative; height: 320px; background: var(--cor-superficie); }
  .capa img { width: 100%; height: 100%; object-fit: cover; display: block; }

  .voltar {
    position: absolute;
    top: 16px;
    left: 16px;
    display: inline-flex;
    align-items: center;
    height: 38px;
    padding: 0 14px;
    border-radius: var(--raio-pilula);
    border: 1px solid rgba(255, 255, 255, .4);
    background: rgba(11, 11, 11, .45);
    color: var(--cor-papel);
    font-size: 12.5px;
    font-weight: 600;
    text-decoration: none;
  }

  .corpo { padding: 24px 20px 34px; background: var(--cor-papel); }

  h1 {
    font-family: var(--fonte-titulo);
    font-size: 32px;
    line-height: 1;
    letter-spacing: -.02em;
    text-transform: uppercase;
    margin: 0 0 8px;
  }
  .preco { font-family: var(--fonte-titulo); font-size: 24px; color: var(--cor-verde-escuro); }

  .descricao {
    margin: 14px 0 20px;
    font-size: 14.5px;
    line-height: 1.6;
    color: rgba(11, 11, 11, .72);
  }

  .escolha { display: block; margin-bottom: 16px; }
  .escolha span {
    display: block;
    font-size: 10px;
    letter-spacing: .18em;
    text-transform: uppercase;
    color: rgba(11, 11, 11, .5);
    margin-bottom: 6px;
  }
  .escolha select {
    width: 100%;
    min-height: 48px;
    padding: 0 14px;
    border: 1px solid var(--cor-divisa);
    border-radius: 14px;
    background: var(--cor-papel);
    font-family: inherit;
    font-size: 15px;
  }

  .adicionar {
    width: 100%;
    min-height: 52px;
    border: 0;
    border-radius: var(--raio-pilula);
    background: var(--cor-verde);
    color: var(--cor-tinta);
    font-family: var(--fonte-titulo);
    font-size: 15px;
    cursor: pointer;
  }

  .frete {
    margin: 12px 0 0;
    font-size: 11.5px;
    line-height: 1.45;
    color: var(--cor-tinta-58);
  }

  .mais-fotos { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 24px; }
  .mais-fotos img {
    width: 100%;
    height: 160px;
    object-fit: cover;
    border-radius: 16px;
    display: block;
  }
</style>
